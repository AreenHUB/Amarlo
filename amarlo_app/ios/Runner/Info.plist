<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ─── App Identity ──────────────────────── -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Amarlo</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>amarlo</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <!-- ─── Permissions ────────────────────────── -->

    <!-- Photo Library -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Amarlo needs access to your photo library to upload profile pictures and service images.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Amarlo needs permission to save downloaded files to your photo library.</string>

    <!-- Camera -->
    <key>NSCameraUsageDescription</key>
    <string>Amarlo needs camera access to take photos for your profile or services.</string>

    <!-- Microphone (for future voice notes) -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Amarlo may need microphone access for voice messages.</string>

    <!-- File access -->
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Amarlo needs access to documents to upload work files in the Safe Area.</string>

    <!-- Network -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Allow local development server -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <!-- Allow specific domains in production -->
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
        <!-- Set to false in production! -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- ─── Flutter ─────────────────────────────── -->
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- Background modes (for WebSocket keep-alive) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>

    <!-- URL schemes for url_launcher -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>https</string>
        <string>http</string>
        <string>tel</string>
        <string>mailto</string>
    </array>

    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
</dict>
</plist>
